generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Staff ───────────────────────────────────────────────────────────────
enum Role {
  admin // manage settings, staff, and everything an educator can do
  educator // day-to-day: families, children, check-in/out, payments
}

enum UserStatus {
  active
  suspended
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String? // optional — records/receipts only, not used for login
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  role         Role       @default(educator)
  status       UserStatus @default(active)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("users")
}

// ── Families ────────────────────────────────────────────────────────────
// The primary parent/guardian for a child. Their own contact details double
// as the first emergency contact; additional emergency contacts live below.
model Guardian {
  id           String   @id @default(uuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  relationship String? // mother / father / guardian / carer
  phone        String
  email        String?
  addressLine  String?  @map("address_line")
  suburb       String?
  postcode     String?
  notes        String?
  // Waiver acceptance captured at parent self-registration. The signature image
  // (a data URL) is personal data, so it's encrypted at the app layer like
  // medical notes. Null when a family was added by staff without a signature.
  waiverSignatureEncrypted String?   @map("waiver_signature_encrypted")
  waiverAcceptedAt         DateTime? @map("waiver_accepted_at")
  waiverVersion            Int?      @map("waiver_version")
  createdAt    DateTime @default(now()) @map("created_at")

  children Child[]

  @@map("guardians")
}

model Child {
  id         String   @id @default(uuid())
  guardianId String   @map("guardian_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  // Birth month (1-12) + year only — age is computed so it's never stale.
  birthMonth Int?     @map("birth_month")
  birthYear  Int?     @map("birth_year")
  // Allergies / medical requirements — encrypted at the application layer.
  medicalNotesEncrypted String? @map("medical_notes_encrypted")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  guardian          Guardian           @relation(fields: [guardianId], references: [id])
  emergencyContacts EmergencyContact[]
  attendances       Attendance[]
  incidents         Incident[]

  @@index([guardianId])
  @@map("children")
}

// Extra people (grandparent, neighbour…) reachable in an emergency and/or
// authorised to collect the child.
model EmergencyContact {
  id           String   @id @default(uuid())
  childId      String   @map("child_id")
  name         String
  relationship String?
  phone        String
  canPickup    Boolean  @default(true) @map("can_pickup")
  createdAt    DateTime @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("emergency_contacts")
}

// ── Attendance (pre-booked sessions AND walk-in drop-ins) ────────────────
enum AttendanceStatus {
  booked // pre-booked for a future window, not yet arrived
  checked_in // currently in care
  checked_out // collected
  cancelled
  no_show
}

enum PaymentStatus {
  unpaid
  authorized // card hold placed (online booking), not yet captured
  paid
  waived
}

enum PaymentMethod {
  cash
  card
  eftpos
  online
}

model Attendance {
  id             String           @id @default(uuid())
  childId        String           @map("child_id")
  // The service day (local). scheduledStart/End are set for a pre-booking;
  // a drop-in is created straight into checked_in with no schedule.
  serviceDate    DateTime         @map("service_date")
  scheduledStart DateTime?        @map("scheduled_start")
  scheduledEnd   DateTime?        @map("scheduled_end")
  isDropIn       Boolean          @default(false) @map("is_drop_in")
  status         AttendanceStatus @default(booked)
  checkInAt      DateTime?        @map("check_in_at")
  checkOutAt     DateTime?        @map("check_out_at")
  checkedInById  String?          @map("checked_in_by_id")
  checkedOutById String?          @map("checked_out_by_id")
  // Which court the parent is on while the child is in care — so staff can
  // find them quickly. Chosen from the configured court list. Required for
  // pre-booked sessions (creche is only offered alongside a court booking).
  court          String?
  // The name the court is booked under, when it differs from the creche
  // booking / parent (e.g. a partner booked the court).
  courtBookingName String? @map("court_booking_name")
  // Fee finalised at check-out from the actual time in care (or estimated
  // from the booked window before then), on the site hourly rate.
  feeCents              Int            @default(0) @map("fee_cents")
  paymentStatus         PaymentStatus  @default(unpaid) @map("payment_status")
  paymentMethod         PaymentMethod? @map("payment_method")
  // Unique: a Stripe intent can settle exactly one attendance (replay guard).
  // Multiple NULLs are allowed, so unpaid/cash rows are unaffected.
  stripePaymentIntentId String?        @unique @map("stripe_payment_intent_id")
  paidAt                DateTime?      @map("paid_at")
  // Money given back when a paid booking is cancelled (late-cancel policy).
  // feeCents stays the amount charged; net = feeCents - refundedCents.
  refundedCents         Int            @default(0) @map("refunded_cents")
  refundedAt            DateTime?      @map("refunded_at")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id])

  @@index([serviceDate])
  @@index([status])
  @@map("attendances")
}

// ── Parent booking requests (external, staff-confirmed) ─────────────────
// A parent pre-books from outside; they pre-pay the estimated fee and the
// request waits for a staff member to confirm (which creates the real booking)
// or decline (which refunds). Parent-typed details are held here verbatim and
// never silently linked to an existing family — staff match or create on
// confirm.
enum BookingRequestStatus {
  pending // paid, awaiting a staff decision
  confirmed // staff created a booking from it
  declined // staff declined; prepayment refunded
  cancelled // withdrawn / expired
}

model BookingRequest {
  id              String   @id @default(uuid())
  parentFirstName String   @map("parent_first_name")
  parentLastName  String   @map("parent_last_name")
  parentPhone     String   @map("parent_phone")
  parentEmail     String?  @map("parent_email")
  childFirstName  String   @map("child_first_name")
  childLastName   String   @map("child_last_name")
  childBirthMonth Int?     @map("child_birth_month")
  childBirthYear  Int?     @map("child_birth_year")
  requestedStart  DateTime @map("requested_start")
  requestedEnd    DateTime @map("requested_end")
  // The court booking this creche session is attached to (required at request
  // time) and the name it's booked under if different from the parent.
  court            String?
  courtBookingName String? @map("court_booking_name")
  feeCents        Int      @map("fee_cents")
  notes           String?

  status BookingRequestStatus @default(pending)

  // Prepayment (mirrors the attendance payment fields).
  paymentStatus         PaymentStatus @default(unpaid) @map("payment_status")
  // Unique: one Stripe intent settles one request (replay guard). See Attendance.
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  paidAt                DateTime?     @map("paid_at")

  // Set when a staff member decides: the booking it produced + the matched or
  // newly-created child.
  attendanceId String?   @unique @map("attendance_id")
  childId      String?   @map("child_id")
  decidedAt    DateTime? @map("decided_at")
  decidedById  String?   @map("decided_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  children BookingRequestChild[]

  @@index([status])
  @@map("booking_requests")
}

// One child on an online booking (a booking may include several children on the
// same session + one payment). On confirm, each row records the created/matched
// child and its attendance.
model BookingRequestChild {
  id         String  @id @default(uuid())
  requestId  String  @map("request_id")
  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  birthMonth Int?    @map("birth_month")
  birthYear  Int?    @map("birth_year")
  feeCents   Int     @map("fee_cents")
  childId      String? @map("child_id")
  attendanceId String? @unique @map("attendance_id")

  request BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("booking_request_children")
}

// ── Incidents ───────────────────────────────────────────────────────────
// Who told us about the incident — not an app role. Parents have no logins;
// a staff member records what a parent reported at the desk.
enum IncidentReporter {
  staff
  parent
}

model Incident {
  id         String           @id @default(uuid())
  // Usually the child involved; null for incidents with no specific child
  // (e.g. a hazard a parent noticed).
  childId    String?          @map("child_id")
  occurredAt DateTime         @map("occurred_at")
  reportedBy IncidentReporter @default(staff) @map("reported_by")
  // The parent's name when reportedBy = parent.
  reporterName String? @map("reporter_name")
  // Tick-box categories from the fixed list in incidents.dto.ts ("other"
  // requires a description).
  types String[] @default([])
  // Free-text details — may describe a child's injuries/health, so encrypted
  // at the app layer like medical notes.
  descriptionEncrypted String?  @map("description_encrypted")
  loggedById           String   @map("logged_by_id")
  createdAt            DateTime @default(now()) @map("created_at")

  child Child? @relation(fields: [childId], references: [id])

  @@index([occurredAt])
  @@index([childId])
  @@map("incidents")
}

// ── Audit log ───────────────────────────────────────────────────────────
// One row per API request worth auditing: every mutation (including denied
// and failed ones) plus reads of sensitive detail (family records). Written
// by middleware on response-finish; append-only — no API can update or
// delete rows. Request bodies are stored redacted (never passwords, Stripe
// secrets, medical notes, signatures, or incident details).
model AuditLog {
  id            String   @id @default(uuid())
  at            DateTime @default(now())
  // Null actor = unauthenticated (public kiosk/booking pages, failed logins).
  actorId       String?  @map("actor_id")
  actorUsername String?  @map("actor_username")
  actorRole     String?  @map("actor_role")
  ip            String?
  userAgent     String?  @map("user_agent")
  method        String
  path          String
  // Path with ids stripped, e.g. "POST /attendance/checkout" — filterable.
  action        String
  // First uuid in the path — the record the request acted on.
  targetId      String?  @map("target_id")
  status        Int
  durationMs    Int      @map("duration_ms")
  detail        Json?

  @@index([at])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// ── Facility (single onsite service) ────────────────────────────────────
model FacilitySettings {
  id              String   @id @default(uuid())
  // Single-facility app: this row is a singleton. The unique-on-a-constant
  // column makes a second settings row impossible at the database level, so a
  // boot-time race can never create duplicates.
  singleton       Boolean  @unique @default(true)
  name            String   @default("CrecheMate")
  timezone        String   @default("Australia/Sydney")
  capacity        Int      @default(20) // max concurrent children
  hourlyRateCents Int      @default(1000) @map("hourly_rate_cents")
  // Longest a single pre-booked session may be (online + staff bookings).
  maxBookingHours Int      @default(2) @map("max_booking_hours")
  // Cancellation policy: a paid booking cancelled within this many hours of the
  // session start is refunded only this percentage; earlier cancellations get
  // 100%. Applied by staff (parents have no login).
  lateCancelWindowHours   Int @default(24) @map("late_cancel_window_hours")
  lateCancelRefundPercent Int @default(50) @map("late_cancel_refund_percent")
  openTime        String   @default("07:00") @map("open_time")
  closeTime       String   @default("18:00") @map("close_time")
  abn             String?
  // The club's courts, offered as a pick-list when checking a child in. Empty
  // = staff type the court free-form.
  courts          String[] @default([])
  // Waiver shown on the parent self-registration form. Editable by an admin;
  // the version bumps whenever the text changes so we can record which wording
  // each parent actually signed.
  waiverText      String?  @map("waiver_text")
  waiverVersion   Int      @default(1) @map("waiver_version")
  // Stripe — link a real account to take card payments. Secret key is
  // encrypted at the app layer; the publishable key is safe to expose to the
  // browser (Stripe Elements needs it). Blank = payments run in offline stub
  // mode.
  stripeSecretKeyEncrypted String? @map("stripe_secret_key_encrypted")
  stripePublishableKey     String? @map("stripe_publishable_key")
  // A known sentinel encrypted with CHILD_DATA_ENCRYPTION_KEY. On boot we verify
  // it still decrypts — detecting a wrong/rotated key BEFORE it silently serves
  // empty medical notes. Set once, never read by the app otherwise.
  encryptionCanary         String? @map("encryption_canary")
  // Xero export config — the revenue account code and AU tax type stamped on
  // every exported sales line, and the invoice-number prefix. Tax treatment is
  // configurable because childcare GST status varies (approved child care is
  // GST-free; a casual club creche may not qualify).
  xeroAccountCode   String @default("200") @map("xero_account_code")
  xeroTaxType       String @default("GST Free Income") @map("xero_tax_type")
  xeroInvoicePrefix String @default("CM") @map("xero_invoice_prefix")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("facility_settings")
}
